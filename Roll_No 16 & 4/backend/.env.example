# College Management System — Environment Configuration Template
# Copy this file to .env and configure your local MySQL credentials.

# Flask Application Settings
SECRET_KEY=college-mgmt-super-secret-key-2026-csbs
FLASK_DEBUG=1

# MySQL Database Connection Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=college_management
