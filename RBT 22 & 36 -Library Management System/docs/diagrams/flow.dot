digraph F { rankdir=TB; graph[nodesep=0.35,ranksep=0.3,pad=0.2]; node[fontname="Times-Roman",fontsize=13,shape=box,style="rounded,filled",fillcolor="#eef2fb",color="#1f3a6e"]; edge[color="#1f3a6e",fontname="Times-Roman",fontsize=11];
s[label="Librarian signs in (session + CSRF token)"]; i0[label="Select member & book"]; c[shape=diamond,label="Rules OK?\ncopies > 0, < 3 books,\nno duplicate, no unpaid fine",fillcolor="#fbf1d9"]; e[label="Show error, change nothing",fillcolor="#fbe3e1"]; i[label="One transaction:\nINSERT Issue (due = today + 14)\nUPDATE Book SET Quantity = Quantity - 1\nINSERT Audit_Log"]; r[label="Return / Renew"]; l[shape=diamond,label="Returned after\ndue date?",fillcolor="#fbf1d9"]; f[label="INSERT Fine (days late x Rs 2)"]; u[label="UPDATE Issue.Return_Date\nUPDATE Book SET Quantity = Quantity + 1"];
s->i0->c; c->e[label="No"]; c->i[label="Yes"]; i->r; r->u; u->l; l->f[label="Yes"]; }
